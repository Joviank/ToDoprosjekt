      "type": "text",
      "x": 363.2995048688499,
      "y": 929.7384627288957,
      "width": 650.5195922851562,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
