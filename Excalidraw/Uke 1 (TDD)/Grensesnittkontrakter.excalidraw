      "boundElements": null,
      "updated": 1788505929381,
      "link": null,
      "locked": false,
      "text": "Hvis vi endrer backend internt burde frontend slutte å virke?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hvis vi endrer backend internt burde frontend slutte å virke?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "d9y-eRO53cLVc6UjlOQND",
      "type": "text",
      "x": 323.8360595703125,
      "y": 245.48507690429688,
      "width": 761.4993896484375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 125198900,
      "version": 229,
      "versionNonce": 855127564,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788506012420,
      "link": null,
      "locked": false,
      "text": "Nei.\n\nDersom en feil oppstår i backend skal dette IKKE påvirke frontend,\nda frontend snakker kun med APIet og har ALDRI direkte tilgang til backend.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nei.\n\nDersom en feil oppstår i backend skal dette IKKE påvirke frontend,\nda frontend snakker kun med APIet og har ALDRI direkte tilgang til backend.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "yjKGGhejeIqSVufwX_v1R",
      "type": "text",
      "x": 438.8492431640625,
      "y": 386.5447692017057,
      "width": 510.7196044921875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3U",
      "roundness": null,
      "seed": 2014520076,
      "version": 105,
      "versionNonce": 1188225292,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788506100417,
      "link": null,
      "locked": false,
      "text": "Stabilitet i systemer kommer fra\nAPI/gresnesnitt-kontrakter, og ikke fra intern kode.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stabilitet i systemer kommer fra\nAPI/gresnesnitt-kontrakter, og ikke fra intern kode.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
