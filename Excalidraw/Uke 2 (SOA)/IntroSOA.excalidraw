      "boundElements": [],
      "updated": 1788768420810,
      "link": null,
      "locked": false,
      "text": "Et image er oppskriften. En container er retten du lager fra den.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Et image er oppskriften. En container er retten du lager fra den.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Yta5yANkWqSFSjT4GfvyZ",
      "type": "text",
      "x": 322.42861090060427,
      "y": 2953.564622709294,
      "width": 946.6593627929688,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b89",
      "roundness": null,
      "seed": 1494952232,
      "version": 259,
      "versionNonce": 1135512920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788768420810,
      "link": null,
      "locked": false,
      "text": "Oppskriften endrer seg ikke av at du koker.\nDu kan lage hundre identiske retter fra samme oppskrift.\nOg to kokker (maskiner) med samme oppskrift lager det samme resultatet uavhengig av hverandre",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Oppskriften endrer seg ikke av at du koker.\nDu kan lage hundre identiske retter fra samme oppskrift.\nOg to kokker (maskiner) med samme oppskrift lager det samme resultatet uavhengig av hverandre",
      "autoResize": true,
