      "text": "Ingress forteller hvor trafikken skal gå.\nReverse proxy sørger for at den faktisk kommer dit",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ingress forteller hvor trafikken skal gå.\nReverse proxy sørger for at den faktisk kommer dit",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "e7RXSVXIDHsVZvVuEVPO0",
      "type": "text",
      "x": 222.45585683921627,
      "y": 1014.1559985365789,
      "width": 990.3992919921875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 890014812,
      "version": 439,
      "versionNonce": 2083183452,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789026074503,
      "link": null,
      "locked": false,
      "text": "Proxy = En mellommann som videresender trafikk\nReverse proxy = Mottar forespørsler fra brukere og sender den til riktig backend tjeneste\nIngress = Kubernets-regler som beskriver hvordan innkommende trafikk skal rutes\n\nIngress controller = Programmet (NGINX, Traefik, HAProxy etc.) som leser ingress reglene og fungerer\nsom en reverse proxy",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proxy = En mellommann som videresender trafikk\nReverse proxy = Mottar forespørsler fra brukere og sender den til riktig backend tjeneste\nIngress = Kubernets-regler som beskriver hvordan innkommende trafikk skal rutes\n\nIngress controller = Programmet (NGINX, Traefik, HAProxy etc.) som leser ingress reglene og fungerer\nsom en reverse proxy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
