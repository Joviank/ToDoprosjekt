      "boundElements": null,
      "updated": 1786437191843,
      "link": null,
      "locked": false,
      "text": "Hvordan tokenet er signert.\n\nHvilken algoritme som er brukt for\nå signere tokenet (HMAC, SHA526 etc).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hvordan tokenet er signert.\n\nHvilken algoritme som er brukt for\nå signere tokenet (HMAC, SHA526 etc).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
