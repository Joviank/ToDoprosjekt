      "isDeleted": false,
      "boundElements": [],
      "updated": 1786437191843,
      "link": null,
      "locked": false,
      "text": "Informasjon om brukeren.\n\nSelve informasjonen (Claims). Her står det\nf.eks hvem du er (userId: D7fhdu35HE)\nog når kortet utløper.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
