    {
      "id": "xeHthNMHum9_PFx7HyRQ_",
      "type": "text",
      "x": 832.9094448913833,
      "y": 1026.9423084575562,
      "width": 621.9281625737999,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 827449665,
      "version": 342,
      "versionNonce": 1675698159,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786435901306,
      "link": null,
      "locked": false,
      "text": "Førerkortet beviser bare at du har lov til å gjøre noe (kjøre\nbil). Det gjør deg ikke automatisk til en godkjent statsborger\npå tvers av landegrenser.\n\nPasset/ID-kort beviser selve identiteten din og at du er \ngodkjent av en øverste myndighet.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Førerkortet beviser bare at du har lov til å gjøre noe (kjøre bil). Det gjør deg ikke automatisk til en godkjent statsborger på tvers av landegrenser.\n\nPasset/ID-kort beviser selve identiteten din og at du er \ngodkjent av en øverste myndighet.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "rTh8likbcOM6qTsfvPGNq",
      "type": "text",
      "x": 183.32545974545678,
      "y": 1209.6416630277743,
      "width": 566.5196533203125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b10",
      "roundness": null,
      "seed": 1673474095,
      "version": 126,
      "versionNonce": 56249985,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786436184037,
      "link": null,
      "locked": false,
      "text": "API = Politiet\nAPI er bare en server som tar imot forespørsler og svarer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API = Politiet\nAPI er bare en server som tar imot forespørsler og svarer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u4iAsCHvZPuJsvGlmC0YG",
      "type": "text",
      "x": 180.0284994690121,
      "y": 1290.24012669213,
      "width": 599.859619140625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b11",
      "roundness": null,
      "seed": 81235183,
      "version": 627,
      "versionNonce": 46417455,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786436210404,
      "link": null,
      "locked": false,
      "text": "Identity Provider (idP) = Statens vegvesen, Google, BankID \nTjenesten som sier hvem du er\n\nAuthentication Provider (AP, brukt litt løst)\nTjenesten som gir deg tilgang basert på identitet.\n(Kan kombineres med idP i praksis)\n\nClaims = Vognkort, navn, email etc.\nInformasjon inne i ID-kortet. \n\nAuthorization = Hva slags type bil du kan kjøre.\nHva du har lov til å gjøre",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Identity Provider (idP) = Statens vegvesen, Google, BankID \nTjenesten som sier hvem du er\n\nAuthentication Provider (AP, brukt litt løst)\nTjenesten som gir deg tilgang basert på identitet.\n(Kan kombineres med idP i praksis)\n\nClaims = Vognkort, navn, email etc.\nInformasjon inne i ID-kortet. \n\nAuthorization = Hva slags type bil du kan kjøre.\nHva du har lov til å gjøre",
      "autoResize": true,
      "lineHeight": 1.25
    },
