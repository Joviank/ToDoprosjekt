      "text": "Vi kan la kode sette opp systemet for å sikre reproduserbarhet.\nDocker bare for servere (Terraform)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vi kan la kode sette opp systemet for å sikre reproduserbarhet.\nDocker bare for servere (Terraform)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3uHJs2-OLWBJ0EixzDKSG",
      "type": "text",
      "x": 552.4064721341083,
      "y": 981.0587139096126,
      "width": 357.6997375488281,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
