      "isDeleted": false,
      "boundElements": null,
      "updated": 1787211180745,
      "link": null,
      "locked": false,
      "text": "Hukommelse (Manuelt)\n1. Lage server\n2. Installere .NET\n3. Åpne port\n4. Deploy",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hukommelse (Manuelt)\n1. Lage server\n2. Installere .NET\n3. Åpne port\n4. Deploy",
