@{
    ViewData["Title"] = "TaskService";
}

<button
    id="themeButton"
    class="theme-button"
    type="button">
    Dark mode
</button>

<div class="container">
    <h1>Hva skal jeg gjøre i dag?</h1>

    <div class="add-task">
        <input
            id="taskInput"
            type="text"
            placeholder="Skriv en ny oppgave" />

        <button
            class="add-button"
            type="button"
            onclick="addTask()" >
            Legg til
        </button>
    </div>

    <ul id="taskList"></ul> 
</div>

@section Scripts {
    <script src="~/js/app.js"></script>
}